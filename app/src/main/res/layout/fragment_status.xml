<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="state"
            type="com.carditek.kesar.bluetooth.State"/>
    </data>

    <!-- Keeps content visible on small screens -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="24dp"
            android:paddingBottom="24dp">

            <!-- Logo -->
            <ImageView
                android:id="@+id/image_logo"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:src="@drawable/android_logo"
                android:contentDescription="@string/android_logo_description"/>

            <!-- BLE state -->
            <TextView
                android:id="@+id/text_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="#E1F5FE"
                android:fontFamily="monospace"
                android:padding="6dp"
                android:text="@{state.state}"
                android:textAlignment="center"
                android:textSize="16sp"/>

            <!-- Packet / byte stats -->
            <TextView
                android:id="@+id/text_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:paddingStart="95dp"
                android:paddingEnd="24dp"
                android:textSize="12sp"/>

            <!-- Ready‑to‑Go banner (initially hidden) -->
            <TextView
                android:id="@+id/text_ready_banner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_banner_ready"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:singleLine="true"
                android:visibility="gone"/>

            <!-- Device Control Switch -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Device Mode:"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="12dp"/>

                <Switch
                    android:id="@+id/switch_device_mode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:thumbTint="@color/device_active_color"
                    android:trackTint="@color/device_active_track_color"/>

                <TextView
                    android:id="@+id/text_device_mode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Active"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginStart="16dp"
                    android:textColor="@color/device_active_color"/>

            </LinearLayout>

            <!-- Start / Stop button -->
            <Button
                android:id="@+id/button_toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Start"/>


            <!-- Battery percentage -->
            <TextView
                android:id="@+id/text_battery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="SYDANTEK LIPO BAT:0%"
                android:textColor="#F44336"
                android:textStyle="bold"/>

            <!-- Battery progress bar -->
            <ProgressBar
                android:id="@+id/progress_battery"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:max="100"
                android:progress="0"

                android:progressDrawable="@drawable/custom_progress_bar"/>
        </LinearLayout>
    </ScrollView>
</layout>
