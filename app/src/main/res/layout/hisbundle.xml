<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ================= HEADER ================= -->

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="HIS BUNDLE"
            android:textColor="#1565C0"
            android:textStyle="bold"
            android:textSize="30sp"
            android:paddingTop="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Electrophysiology Monitor"
            android:textColor="#757575"
            android:textSize="16sp"
            android:paddingBottom="20dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="3dp"
            app:strokeWidth="1dp">

            <TextView
                android:id="@+id/tvMacAddress"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="MACID: "
                android:textSize="16sp"
                android:textStyle="bold"
                android:maxLines="1" />




        </com.google.android.material.card.MaterialCardView>


        <!-- ================= GOOGLE DRIVE LIVE STATUS ================= -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/driveStatusCard"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="3dp"
            app:strokeColor="#D6E4F0"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <!-- DRIVE -->

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="☁"
                        android:textSize="20sp"
                        android:textColor="#1565C0" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Drive"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#263238" />

                </LinearLayout>


                <!-- DIVIDER -->

                <View
                    android:layout_width="1dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="14dp"
                    android:background="#D0D7DE" />


                <!-- UPLOADS -->

                <TextView
                    android:id="@+id/tvDriveUploads"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="↑ Uploads: --"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#263238"
                    android:maxLines="1" />


                <!-- PENDING -->

                <TextView
                    android:id="@+id/tvDrivePending"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="⏳ Pending: --"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#263238"
                    android:maxLines="1" />


                <!-- INTERNET / DRIVE STATUS -->

                <TextView
                    android:id="@+id/tvDriveStatusDot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="●"
                    android:textSize="18sp"
                    android:textColor="#4CAF50"
                    android:contentDescription="Drive connection status" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>
        <!-- ================= PATIENT + HR ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Patient Card -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPatient"
                android:layout_width="0dp"
                android:layout_height="130dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="6dp"
                app:strokeColor="#E0E0E0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="👤 Patient"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:textColor="#37474F" />

                    <TextView
                        android:id="@+id/tvPatientName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" --"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#212121"
                        android:paddingTop="8dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- HR Card -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardHR"
                android:layout_width="0dp"
                android:layout_height="130dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="6dp"
                app:strokeColor="#E0E0E0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="❤ HR"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:textColor="#37474F" />

                    <TextView
                        android:id="@+id/tvHR"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" --BPM"
                        android:textStyle="bold"
                        android:textSize="26sp"
                        android:textColor="#1565C0"
                        android:paddingTop="8dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>



        </LinearLayout>

        <!-- ================= SECTION TITLE ================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Electrophysiology Measurements"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="#263238"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp" />

        <!-- ================= ROW 1: PA / AH / HV ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- PA DURATION CARD -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPADuration"
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="5dp"
                app:strokeColor="#4CAF50"
                app:strokeWidth="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PA"
                        android:textStyle="bold"
                        android:textSize="20sp"
                        android:textColor="#1565C0"/>

                    <TextView
                        android:id="@+id/tvPADuration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-- ms"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:textColor="#212121"
                        android:paddingTop="6dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Normal Range"
                        android:textSize="12sp"
                        android:textColor="#757575"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="25 - 65 ms"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:textColor="#4CAF50"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- AH DURATION CARD -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAHDuration"
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="5dp"
                app:strokeColor="#4CAF50"
                app:strokeWidth="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AH"
                        android:textStyle="bold"
                        android:textSize="20sp"
                        android:textColor="#1565C0"/>

                    <TextView
                        android:id="@+id/tvAHDuration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-- ms"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:textColor="#212121"
                        android:paddingTop="6dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Normal Range"
                        android:textSize="12sp"
                        android:textColor="#757575"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="55 - 125 ms"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:textColor="#4CAF50"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- HV DURATION CARD -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardHVDuration"
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="5dp"
                app:strokeColor="#4CAF50"
                app:strokeWidth="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HV"
                        android:textStyle="bold"
                        android:textSize="20sp"
                        android:textColor="#1565C0"/>

                    <TextView
                        android:id="@+id/tvHVDuration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-- ms"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:textColor="#212121"
                        android:paddingTop="6dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Normal Range"
                        android:textSize="12sp"
                        android:textColor="#757575"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="35 - 55 ms"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:textColor="#4CAF50"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- ================= ROW 2: PR / QRS / H-Amplitude ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:weightSum="3">

            <!-- PR DURATION CARD -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPRDuration"
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="5dp"
                app:strokeColor="#4CAF50"
                app:strokeWidth="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PR Duration"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="#1565C0"/>

                    <TextView
                        android:id="@+id/tvPRDuration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-- ms"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="#212121"
                        android:paddingTop="6dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="120 - 200 ms"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#4CAF50"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- QRS DURATION CARD -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardQRSDuration"
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="5dp"
                app:strokeColor="#4CAF50"
                app:strokeWidth="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="QRS Duration"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="#1565C0"/>

                    <TextView
                        android:id="@+id/tvQRSDuration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-- ms"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="#212121"
                        android:paddingTop="6dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="60 - 110 ms"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#4CAF50"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- H-Amplitude CARD -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardHAmplitude"
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="5dp"
                app:strokeColor="#4CAF50"
                app:strokeWidth="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="H-Amplitude"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="#1565C0"/>

                    <TextView
                        android:id="@+id/tvHAmplitude"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-- mv"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#212121"
                        android:paddingTop="6dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:textSize="12sp"
                        android:textColor="#757575"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:textStyle="bold"
                        android:textColor="#4CAF50"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- ================= ECG GRAPH ================= -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ECG Analysis Graph"
                    android:textColor="#1565C0"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <com.github.chrisbanes.photoview.PhotoView
                    android:id="@+id/imgHisBundle"
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:layout_marginTop="12dp"
                    android:background="#F5F5F5"
                    android:scaleType="fitCenter"
                    android:src="@android:drawable/ic_menu_gallery" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ================= SECTION TITLE: OTHER DETAILS ================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Additional Details"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="#263238"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp" />

        <!-- ================= GRID: REMAINING CARDS ================= -->

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:alignmentMode="alignMargins"
            android:useDefaultMargins="true">

            <!-- ================= BEAT NUMBER CARD ================= -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardBeatNumber"
                android:layout_width="0dp"
                android:layout_height="130dp"
                android:layout_columnWeight="1"
                app:cardCornerRadius="16dp"
                app:cardElevation="5dp"
                app:strokeColor="#4CAF50"
                app:strokeWidth="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Beat Number"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:textColor="#1565C0"/>

                    <TextView
                        android:id="@+id/tvBeatNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:textColor="#212121"
                        android:paddingTop="8dp"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ================= P ONSET LOCATION CARD ================= -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPOnset"
                android:layout_width="0dp"
                android:layout_height="130dp"
                android:layout_columnWeight="1"
                app:cardCornerRadius="16dp"
                app:cardElevation="5dp"
                app:strokeColor="#4CAF50"
                app:strokeWidth="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="P Onset Location"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="#1565C0"
                        android:gravity="center"/>

                    <TextView
                        android:id="@+id/tvPOnsetLocation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="#212121"
                        android:paddingTop="8dp"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ================= P PEAK LOCATION CARD ================= -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPPeak"
                android:layout_width="0dp"
                android:layout_height="130dp"
                android:layout_columnWeight="1"
                app:cardCornerRadius="16dp"
                app:cardElevation="5dp"
                app:strokeColor="#4CAF50"
                app:strokeWidth="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="P Peak Location"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="#1565C0"
                        android:gravity="center"/>

                    <TextView
                        android:id="@+id/tvPPeakLocation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="#212121"
                        android:paddingTop="8dp"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ================= QRS ON LOCATION CARD ================= -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardQRSOn"
                android:layout_width="0dp"
                android:layout_height="130dp"
                android:layout_columnWeight="1"
                app:cardCornerRadius="16dp"
                app:cardElevation="5dp"
                app:strokeColor="#4CAF50"
                app:strokeWidth="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="QRS On Location"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="#1565C0"
                        android:gravity="center"/>

                    <TextView
                        android:id="@+id/tvQRSOnLocation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="#212121"
                        android:paddingTop="8dp"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ================= QRS OFF LOCATION CARD ================= -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardQRSOff"
                android:layout_width="0dp"
                android:layout_height="130dp"
                android:layout_columnWeight="1"
                app:cardCornerRadius="16dp"
                app:cardElevation="5dp"
                app:strokeColor="#4CAF50"
                app:strokeWidth="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="QRS Off Location"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="#1565C0"
                        android:gravity="center"/>

                    <TextView
                        android:id="@+id/tvQRSOffLocation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="#212121"
                        android:paddingTop="8dp"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ================= R PEAK LOCATION CARD ================= -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardRPeak"
                android:layout_width="0dp"
                android:layout_height="130dp"
                android:layout_columnWeight="1"
                app:cardCornerRadius="16dp"
                app:cardElevation="5dp"
                app:strokeColor="#4CAF50"
                app:strokeWidth="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="R Peak Location"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="#1565C0"
                        android:gravity="center"/>

                    <TextView
                        android:id="@+id/tvRPeakLocation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="#212121"
                        android:paddingTop="8dp"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </GridLayout>

        <!-- ================= DOWNLOAD & SHARE BUTTONS ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDownloadCSV"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Download CSV"
                android:textSize="12sp"
                android:textStyle="bold"
                app:icon="@android:drawable/ic_menu_save"
                app:iconGravity="textStart"
                app:cornerRadius="12dp"
                app:backgroundTint="#1565C0" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShareCSV"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Share CSV"
                android:textSize="16sp"
                android:textStyle="bold"
                app:icon="@android:drawable/ic_menu_share"
                app:iconGravity="textStart"
                app:cornerRadius="12dp"
                app:backgroundTint="#4CAF50" />

        </LinearLayout>

        <!-- ================= LAST UPDATED ================= -->

    </LinearLayout>

</ScrollView>
